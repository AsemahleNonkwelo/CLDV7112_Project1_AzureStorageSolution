@model IEnumerable<BlobItemViewModel>
@{
    ViewData["Title"] = "Azure Blob Storage";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">AZURE BLOB STORAGE</p>
        <h1>Product Media</h1>
        <p>Images and multimedia stored in the <strong>productmedia</strong> container.</p>
    </div>
</div>

<div class="upload-card">
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label>Select an image or multimedia file</label>
        <input type="file" name="file" required />
        <button class="btn primary" type="submit">Upload to Blob Storage</button>
    </form>
</div>

<div class="media-grid">
@foreach (var item in Model)
{
    <div class="media-card">
        @if (item.ContentType.StartsWith("image/"))
        {
            <img src="@Url.Action("Download", "Blobs", new { name = item.Name })" alt="@item.Name" />
        }
        else
        {
            <div class="file-placeholder">BLOB</div>
        }
        <div class="media-info">
            <strong>@item.Name</strong>
            <small>@item.ContentType • @(item.Size ?? 0) bytes</small>
            <a class="btn small" asp-action="Download" asp-route-name="@item.Name">Download</a>
            <form asp-action="Delete" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="name" value="@item.Name" />
                <button class="btn small danger-outline" type="submit">Delete</button>
            </form>
        </div>
    </div>
}
</div>

@if (!Model.Any())
{
    <div class="empty">No blobs found. Seed demo data or upload a file.</div>
}
