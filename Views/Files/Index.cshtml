@model IEnumerable<FileItemViewModel>
@{
    ViewData["Title"] = "Azure File Storage";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">AZURE FILE STORAGE</p>
        <h1>Application Logs</h1>
        <p>Log files stored in the <strong>applicationlogs</strong> Azure file share.</p>
    </div>
</div>

<div class="upload-card">
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label>Select a log/text file</label>
        <input type="file" name="file" required />
        <button class="btn primary" type="submit">Upload to Azure Files</button>
    </form>
</div>

<div class="table-wrap">
<table>
    <thead>
    <tr>
        <th>File Name</th>
        <th>Size</th>
        <th>Last Modified</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td><strong>@item.Name</strong></td>
            <td>@(item.Size ?? 0) bytes</td>
            <td>@(item.LastModified?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A")</td>
            <td><a class="btn small" asp-action="Download" asp-route-name="@item.Name">Download</a></td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (!Model.Any())
{
    <div class="empty">No files found. Seed demo data or upload a log file.</div>
}
